# FINMAN / OBO Financial System — environment variables (NAMES ONLY).
# Copy to .env for local development and fill in the values there.
# NEVER commit .env, and never put real passwords or secrets in this file.

# --- MySQL (on GoDaddy Node.js Hosting these are set by the platform for the
# --- managed MySQL database; do not set them yourself there) ---
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Required secret: long random value (e.g. 48+ random bytes as hex) ---
JWT_SECRET=

# --- First start of a BRAND-NEW installation only: initial Super Admin password ---
SUPER_ADMIN_INITIAL_PASSWORD=

# --- Optional ---
# PORT=                    # provided by the hosting platform; 4000 locally
# BACKUP_ENABLED=          # "0" turns automatic backups off (default on)
# BACKUP_INTERVAL_HOURS=   # default 24
# BACKUP_KEEP=             # automatic/manual backups kept per company, default 30
# DB_QUERY_TIMEOUT_MS=     # default 25000
# DB_CONNECT_TIMEOUT_MS=   # default 10000
# DB_SSL_CA=               # cloud MySQL (Aiven): its CA certificate (PEM) -> verified TLS
# DB_SSL=                  # "require" -> TLS without certificate check (prefer DB_SSL_CA)
# RESET_OPERATIONAL_DATA=  # one-time owner-approved reset only; leave unset

# --- Development / tests only (a disposable local MySQL, never production) ---
# TEST_MYSQL_HOST=
# TEST_MYSQL_PORT=
# TEST_MYSQL_USER=
# TEST_MYSQL_PASSWORD=
# SEED_DEMO_PASSWORD=
